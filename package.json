{
  "name": "dsh-reasoning-support",
  "version": "0.2.1",
  "description": "DSV4.1 reasoning support with multimodal context and bounded artifact acceptance for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "runtime",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "dsh",
    "cordis",
    "reasoning",
    "dsv4.1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test runtime/*.test.mjs tests/*.test.mjs",
    "test:runtime": "node --test runtime/*.test.mjs",
    "test:native": "node scripts/test-native.mjs",
    "check": "node --check install.mjs && node scripts/manifest.mjs --check",
    "manifest": "node scripts/manifest.mjs"
  }
}
